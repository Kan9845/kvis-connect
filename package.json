{
  "name": "kvis-connect",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "db": "docker compose up db -d",
    "be": "cd backend && .venv\\Scripts\\uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "fe": "cd frontend && pnpm dev",
    "fe:staging": "pnpm --dir frontend run dev:staging",
    "build:fe": "pnpm --dir frontend run build",
    "build:fe:staging": "pnpm --dir frontend run build:staging",
    "lint:fe": "pnpm --dir frontend run lint",
    "typecheck:fe": "pnpm --dir frontend run type-check",
    "refresh:population-snapshot": "node scripts/generate-population-snapshot.mjs",
    "migrate": "cd backend && .venv\\Scripts\\alembic upgrade head",
    "migration": "cd backend && .venv\\Scripts\\alembic revision --autogenerate -m",
    "install:be": "cd backend && python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
    "install:fe": "cd frontend && pnpm install"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
