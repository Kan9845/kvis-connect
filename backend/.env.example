# Database
DATABASE_URL=postgresql://<user>:<password>@<your-production-host>:<port>/kvisconnect

# App
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kvis-connect
S3_REGION=

# Redis
REDIS_URL=redis://localhost:6380/0
CACHE_ENABLED=false
CACHE_TTL_SHORT=120
CACHE_TTL_LONG=300

# Email - Microsoft Graph API (provided by school IT)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=otp@kvis.ac.th
